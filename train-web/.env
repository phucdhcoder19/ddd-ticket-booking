# Spring Boot backend runs on port 9999, every @RestController is prefixed with /api
VITE_API_BASE_URL=http://localhost:9999/api

# true  = run the in-browser mock, no backend needed
# false = call the real backend
#
# Real endpoints: /stations, /sale-window, /trips, /trips/{id}/carriages,
# /holds (POST/GET/DELETE), /holds/{id}/passengers (PUT), /orders (POST/GET), /me/tickets (GET),
# /tickets/{id}/refund (POST), /auth/register + /auth/login (POST), /me (GET).
# Booking endpoints need a signed-in user: the token is sent as "Authorization: Bearer".
#
# /queue is a real waiting room on Redis. Once admitted, the token is kept in sessionStorage
# (trainbooking.queue.pass) and sent with every request in the X-Queue-Token header.
VITE_USE_MOCK=false
