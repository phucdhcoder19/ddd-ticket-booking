# Backend Spring Boot chay o cong 9999, moi @RestController duoc gan tien to /api
VITE_API_BASE_URL=http://localhost:9999/api

# true  = chay mock ngay trong trinh duyet, khong can backend
# false = goi backend that
#
# Da co that: /stations, /sale-window, /trips, /trips/{id}/carriages,
# /holds (POST/GET/DELETE), /holds/{id}/passengers (PUT), /orders (POST/GET).
#
# Con thieu -> man hinh tuong ung se bao loi, do la binh thuong:
#   GET /me/tickets              man ve cua toi
#
# /queue da co nhung dang la CUA MO: cho qua ngay, chua xep hang that.
VITE_USE_MOCK=false
