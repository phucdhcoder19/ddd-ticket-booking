# Backend Spring Boot chay o cong 9999, moi @RestController duoc gan tien to /api
VITE_API_BASE_URL=http://localhost:9999/api

# true  = chay mock ngay trong trinh duyet, khong can backend
# false = goi backend that
#
# Da bat sang backend that: /stations va /sale-window da co.
# Cac duong /trips, /holds... van chua co -> man chon chuyen se bao loi,
# do la binh thuong, se lam o Buoc 2 (bai 18).
VITE_USE_MOCK=false
